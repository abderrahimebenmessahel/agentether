# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Secrets: never commit a key or a .env file
.env
.env.*
*.pem
*.key

# AgenTether project memories (they are runtime data, not source)
memory/
memory*/
project-memory/
*.memory/

# Benchmark scratch files
benchmarks/results/*.tmp
benchmarks/results/*.log

# Working logs of the audit sessions (raw command output, never a secret)
logs/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
